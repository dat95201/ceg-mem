# Copy this file to .env and fill in the secret values.
#   cp .env.example .env

# ── Model / API (src/llm.py) ────────────────────────────────────────────────
# src/llm.py speaks OpenAI chat-completions. The values below are the cloud
# profile. To run against a local Ollama instead, do NOT edit this file -
# load_dotenv() does not override variables already in the environment, so
# prefix the command:
#
#   LLM_BASE_URL=http://localhost:11435/v1 LLM_API_KEY=unused \
#   MODEL=qwen2.5-coder:7b LLM_CONTEXT_TOKENS=32768 \
#   PRICE_IN_PER_MTOK=0 PRICE_OUT_PER_MTOK=0 \
#   CALLS_LOG=data/calls_smoke.jsonl python3 -m src.llm
#
# That is the shape of it; for anything that produces data, use
# scripts/screen_shard.sh instead. It starts its own server with the context
# window pinned and verifies what the server actually serves before spending -
# see LLM_CONTEXT_TOKENS below for why that is not optional.

# Empty means the SDK default, api.openai.com. Set it to point elsewhere.
LLM_BASE_URL=

# OpenAI API key. Required for live cloud calls; cached responses replay
# without one, and scripts/check_consistency.py never needs it. Any non-empty
# string works against Ollama, which does not check it.
LLM_API_KEY=

# Model id passed straight to chat.completions.create(model=...).
#
# Chat models (gpt-4o-mini, gpt-5-mini, qwen2.5-coder:7b, ...) take this path
# unchanged. o-series ids (o4-mini, o3, ...) are detected by src/llm.py and
# routed differently: `max_completion_tokens` instead of `max_tokens`, no
# `temperature` at all (the o-series accepts only its own default), and hidden
# reasoning tokens billed as output. src/proposer.py also raises the output
# ceiling for them, because reasoning is spent out of the same budget as the
# answer and the chat-model ceiling would truncate the program.
#
# pi is a property of the model, so changing this is changing the experiment:
# the corpus bands, the screen and the grid must all be under one id, and
# `model` is in the cell key so two ids never pool. To run a second proposer,
# run it as its own arm with its own --out / shard tag, not by editing this.
MODEL=gpt-4o-mini

# o-series ONLY: low | medium | high. Leave empty for every chat model -
# src/llm.py raises rather than accept the combination, because the effort would
# enter the cache key and the experiment cell key while changing nothing about
# the call.
#
# It is protocol, not a tuning knob: it changes the proposal distribution, so it
# is recorded in the cache key, in every metrics row and in the shard's
# .meta.json, and scripts/consolidate_evals.py refuses to merge two efforts.
REASONING_EFFORT=

# Sampling temperature, passed explicitly on every call and recorded in
# data/calls.jsonl. Proposal diversity across rounds is the thing being
# measured, so this must not be left to an SDK default that could change.
# Ignored on the o-series - see MODEL above.
TEMPERATURE=1.0

# Seconds before a single call is abandoned. The SDK's own default is 600,
# which is under the ~1000s a local 7B needs to fill the largest output budget
# src/proposer.py hands out, so a legitimate call would be recorded as a
# harness failure.
LLM_TIMEOUT_SEC=1800
LLM_MAX_RETRIES=5

# Context window the server is actually serving, or 0 to skip the check.
# Set this for any local backend. Ollama truncates an over-long prompt instead
# of refusing it, and the OpenAI-compatible endpoint has no field to raise the
# window - it is a server-side default, picked from available VRAM ("4k/32k/256k",
# per `ollama serve --help`), so the same model id on two machines can be two
# different instruments. The memory arms carry accumulated evidence and so have
# the longest prompts, so silent truncation lands hardest on exactly the
# comparison being measured.
#
# Pin it with OLLAMA_CONTEXT_LENGTH on the server and check what it actually
# serves at /api/ps - scripts/screen_shard.sh does both and refuses to start on a
# mismatch. This variable is the client-side half: it turns a prompt that would
# not fit into a ContextOverflow rather than a truncated answer.
LLM_CONTEXT_TOKENS=0

# ── Cost accounting (src/llm.py) ────────────────────────────────────────────
# USD per 1,000,000 input / output tokens. Used only to price each call for
# data/calls.jsonl; get these from your provider's pricing page. The values
# here are gpt-4o-mini's; a local backend costs nothing, so set both to 0.
#
# Rate cards, for reference (verify against the pricing page before a paid run):
#   gpt-4o-mini   0.15 / 0.60
#   o4-mini       1.10 / 4.40   - and reasoning tokens are billed as output, so
#                                 the effective output rate is several times the
#                                 visible-token count. Budget accordingly.
# The shard scripts require both to be set explicitly under --backend cloud;
# an unpriced ledger cannot be re-priced afterwards, because the token counts
# survive but which rate applied does not.
PRICE_IN_PER_MTOK=0.15
PRICE_OUT_PER_MTOK=0.60

# Hard spending ceiling in USD. llm.complete() raises BudgetExceeded once
# llm.spent() (summed from CALLS_LOG) reaches this value.
#
# PER PROCESS, and that matters the moment more than one shard runs at a time:
# every shard gets its own ledger, and llm.spent() sums only its own. N parallel
# shards therefore need total/N each, or the real ceiling is N times this.
BUDGET_USD_CAP=40.0

# ── Sandbox (src/sandbox.py) ─────────────────────────────────────────────────
# Wall-clock seconds a candidate gets before the subprocess is killed as hung.
# AtCoder inputs run to ~2*10^5 items and a correct CPython solution can
# legitimately need seconds on the largest case, so this cannot be as tight as
# it would be for a small self-contained function.
SANDBOX_TIMEOUT_SEC=10.0

# Python recursion ceiling installed in the sandboxed subprocess before the
# candidate runs. Contest solutions recurse over the whole input (DFS on 10^5
# nodes), so CPython's default of 1000 would turn correct programs into
# RecursionErrors. Raising this much further risks blowing the C stack, which
# surfaces as a WorkerCrash outcome rather than a clean exception.
SANDBOX_RECURSION_LIMIT=10000

# ── Benchmark (src/adapter.py) ───────────────────────────────────────────────
# Local checkout of https://github.com/appmlk/ConDefects. Needs both the code
# (cloned) and Test/ (Test.zip, downloaded by hand) - see README Setup, or run
# `python3 scripts/fetch_condefects.py`.
CONDEFECTS_ROOT=external/ConDefects
# Defaults to $CONDEFECTS_ROOT/Test. Set it only to point at a partial test
# tree - Test.zip is large enough that a truncated download is a real risk, and
# keeping the salvage out of Test/ stops an incomplete pool being frozen into a
# corpus by accident. Unset it before the freeze that goes in the paper.
# CONDEFECTS_TEST_DIR=external/ConDefects/Test_partial

# ── Storage paths (src/llm.py) ──────────────────────────────────────────────
# On-disk response cache and append-only call log.
CACHE_DIR=cache
CALLS_LOG=data/calls.jsonl

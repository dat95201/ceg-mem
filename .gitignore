# ── python / editor ───────────────────────────────────────────────────────────
.venv/
__pycache__/
*.pyc
.pytest_cache/
.env
NOTES.md
.DS_Store
**/.DS_Store
.claude/
_to_delete/

# ── run outputs: never tracked ───────────────────────────────────────────────
# data/ holds only source (mutants.py) and the placeholder. Every run writes to
# data/<RUN_DIR>/ (src/paths.py, scripts/run_dir_paths.sh); the reported runs
# are shipped as artifacts (scripts/build_artifacts.py) and installed by
# scripts/fetch_artifacts.py, not committed.
data/*
!data/.gitkeep
!data/mutants.py
data/repro-*/
logs/
cache/*
!cache/.gitkeep

# the shipped artifacts, unpacked or downloaded by scripts/fetch_artifacts.py
artifacts/
artifacts*.zip

# the benchmark checkout (scripts/fetch_condefects.py) and partial Test/ archives
external/
/test_*.zip

# ── paper build ──────────────────────────────────────────────────────────────
# Build products are not tracked, with one exception: paper/main.pdf is the
# reference build scripts/reproduce.sh must reproduce. The figures under
# paper/common/figures/ are inputs of the LaTeX build (tools/make_figures.py
# regenerates them from numbers.json + figdata.json) and stay tracked.
paper/**/*.pdf
!paper/main.pdf
!paper/common/figures/*.pdf
paper/**/*.aux
paper/**/*.log
paper/**/*.out
paper/**/*.bbl
paper/**/*.blg
paper/**/*.fls
paper/**/*.fdb_latexmk
paper/**/*.synctex.gz
paper/**/*.toc
paper/**/*.lof
paper/**/*.lot
paper/**/*.brf
paper/*.zip
paper/common/.regen/
